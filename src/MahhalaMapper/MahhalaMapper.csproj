<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Summary>A convention-based object-object mapper.</Summary>
    <Description>A convention-based object-object mapper.</Description>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>MahhalaMapper</AssemblyName>
    <AssemblyOriginatorKeyFile>..\..\MahhalaMapper.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign Condition=" '$(OS)' != 'Windows_NT' ">true</PublicSign>
    <PackageId>MahhalaMapper</PackageId>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/MahhalaMapper/MahhalaMapper</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <BaselineAllAPICompatError>true</BaselineAllAPICompatError>
    <AdditionalApiCompatOptions>--exclude-non-browsable --exclude-compiler-generated</AdditionalApiCompatOptions>

    <!-- No previous major version to compare against yet (MahhalaMapper starts at v1.0.0) -->
    <RunApiCompat Condition="!Exists('..\LastMajorVersionBinary\MahhalaMapper.dll')">false</RunApiCompat>
    <AssemblyTitle>Mahhala Mapper</AssemblyTitle>
    <ApplicationIcon>MahhalaMapper.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="MahhalaMapper.ico" />
  </ItemGroup>

  <ItemGroup>
    <ResolvedMatchingContract Include="..\LastMajorVersionBinary\MahhalaMapper.dll" Condition="Exists('..\LastMajorVersionBinary\MahhalaMapper.dll')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="" Visible="False" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="False" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Polyfill" Version="1.0.165" Condition="'$(TargetFramework)' == 'netstandard2.0'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="System.Reflection.Emit" Version="4.7.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
    <PackageReference Include="Microsoft.DotNet.ApiCompat" Version="7.0.0-beta.22074.1" PrivateAssets="All" />  
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- Limit polyfills to the BCL shims actually needed by the project and its referenced packages. -->
    <MeziantouPolyfill_IncludedPolyfills>M:System.ArgumentNullException.ThrowIfNull;M:System.ArgumentOutOfRangeException.ThrowIfNegativeOrZero;M:System.Array.;M:System.ArraySegment`1.;M:System.BitConverter.;M:System.Boolean.TryFormat;M:System.Collections.Concurrent.;M:System.Collections.Generic.CollectionExtensions.;M:System.Collections.Generic.Dictionary`2.;M:System.Collections.Generic.KeyValuePair`2.;M:System.Collections.Generic.Queue`1.;M:System.Collections.Generic.Stack`1.;M:System.DateTime.;M:System.DateTimeOffset.;M:System.Guid.CreateVersion7;M:System.IO.Path.GetFileName;M:System.Linq.Enumerable.;M:System.MemoryExtensions.;M:System.Random.;M:System.Security.Cryptography.;M:System.String.;M:System.Threading.Interlocked.;M:System.Threading.Tasks.ValueTask.;M:System.Type.GetConstructor;M:System.Type.GetMethod;T:System.Buffers.SearchValues;T:System.Collections.ObjectModel.ReadOnlySet`1;T:System.Diagnostics.CodeAnalysis.;T:System.HashCode;T:System.Index;T:System.Net.Mime.MediaTypeNames.;T:System.Range;T:System.Runtime.CompilerServices.;T:System.Runtime.InteropServices.;T:System.Security.Cryptography.CryptographicOperations;T:System.Text.RegularExpressions.Regex.ValueMatchEnumerator;T:System.Text.RegularExpressions.Regex.ValueSplitEnumerator;T:System.Text.RegularExpressions.ValueMatch</MeziantouPolyfill_IncludedPolyfills>
    <!-- Opt-out: semicolon-separated or pipe-separated list of name prefixes to exclude (blocklist) -->
    <!-- Polyfills matching these prefixes will NOT be generated -->
    <MeziantouPolyfill_ExcludedPolyfills>M:System.Convert.</MeziantouPolyfill_ExcludedPolyfills>
    <EmitCompilerGeneratedFiles>True</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\GeneratedFiles</CompilerGeneratedFilesOutputPath>
    <!-- Optional: Generate Debug.g.cs with polyfill generation decisions and skip reasons -->
    <MeziantouPolyfill_GenerateDebugFile>true</MeziantouPolyfill_GenerateDebugFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <Target Name="PreBuild" AfterTargets="GetAssemblyVersion">
    <Exec Condition=" '$(OS)' == 'Windows_NT' " Command="powershell -NoProfile -ExecutionPolicy Unrestricted -File &quot;$(ProjectDir)ApiCompat\PreBuild.ps1&quot; -version $(Version)" />
    <Exec Condition=" '$(OS)' != 'Windows_NT' " Command="&quot;$(ProjectDir)ApiCompat/PreBuild.sh&quot; $(Version)" />
  </Target>
  <ItemGroup>
    <Using Include="System.Linq.Expressions.Expression" Static="true" />
    <Using Include="MahhalaMapper.Execution.ExpressionBuilder" Static="true" />
    <Using Include="MahhalaMapper.Execution" />
    <Using Include="MahhalaMapper.Configuration" />
  </ItemGroup>
</Project>